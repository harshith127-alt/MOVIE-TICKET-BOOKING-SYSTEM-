# Copy this file to `.env` and adjust if needed.
PORT=3000

# MongoDB connection string. By default the server starts a local mongod
# automatically and connects to this URI.
MONGO_URI=mongodb://127.0.0.1:27017/cinebroke

# Path to mongod.exe - auto-detected if left empty.
# Example: D:\\tools\\mongodb\\bin\\mongod.exe
MONGO_BIN=

# Optional: auth token lifetime in days
SESSION_DURATION_DAYS=7